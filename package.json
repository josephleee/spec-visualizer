{
  "name": "spec-visualizer",
  "version": "0.1.0",
  "description": "A local, read-only dashboard for GitHub spec-kit projects: the six spec-driven stages on one board, and every spec document as a page that fits its kind.",
  "keywords": [
    "spec-kit",
    "spec-driven-development",
    "sdd",
    "specification",
    "dashboard",
    "visualizer",
    "markdown",
    "cli"
  ],
  "license": "MIT",
  "author": "josephleee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephleee/spec-visualizer.git"
  },
  "homepage": "https://github.com/josephleee/spec-visualizer#readme",
  "bugs": "https://github.com/josephleee/spec-visualizer/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "spec-visualizer": "dist/server/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/server",
    "dist/web",
    "examples/demo"
  ],
  "scripts": {
    "start": "node server/cli.ts",
    "dev": "vite",
    "build": "vite build && npm run build:server",
    "build:server": "node -e \"fs.rmSync('dist/server',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build",
    "preversion": "npm test",
    "version": "node scripts/version.mjs && git add plugin/.claude-plugin/plugin.json .claude-plugin/marketplace.json CHANGELOG.md"
  },
  "dependencies": {
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
